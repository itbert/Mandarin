---
import { getCollection } from 'astro:content';
import { currentSection, withBase } from '../config/sections';
const { entry } = Astro.locals.starlightRoute;
const section = currentSection(Astro.url.pathname);
const lessons = entry.data.lesson && section ? (await getCollection('docs', (page) => page.id.startsWith(`${section.id}/`) && page.data.lesson && !page.data.draft && !page.data.sidebar.hidden)).sort((a, b) => (a.data.sidebar.order ?? 100) - (b.data.sidebar.order ?? 100) || a.id.localeCompare(b.id)) : [];
const index = lessons.findIndex((page) => page.id === entry.id);
const previous = index > 0 ? lessons[index - 1] : undefined;
const next = index >= 0 ? lessons[index + 1] : undefined;
const link = (id: string) => withBase(`/${id.replace(/\/index$/, '')}/`);
---
{entry.data.lesson && <nav class="lesson-pagination" aria-label="Последовательное чтение" data-pagefind-ignore>
  {previous ? <a href={link(previous.id)} rel="prev"><span>← Предыдущая статья</span>{previous.data.title}</a> : <a href={withBase('/analysis/')}><span>← К содержанию</span>Математический анализ</a>}
  {next ? <a href={link(next.id)} rel="next"><span>Следующая статья →</span>{next.data.title}</a> : <a href={withBase('/analysis/plan/')}><span>Дальше по программе →</span>Посмотреть план учебника</a>}
</nav>}
