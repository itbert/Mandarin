    "astro": "7.2.10",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/cli": "0.1.22",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  }
